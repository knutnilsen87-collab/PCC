{
  "name": "@pcc/windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "desktop:dev": "vite build && electron .",
    "desktop:pack": "vite build && electron-builder --win dir",
    "desktop:smoke": "node desktop/smoke.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo lint:windows"
  },
  "dependencies": {
    "@pcc/assistant": "workspace:*",
    "@pcc/domain": "workspace:*",
    "@pcc/local-fs": "workspace:*",
    "@pcc/project-import": "workspace:*",
    "@pcc/schemas": "workspace:*",
    "@pcc/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.projectcommandcenter.pcc",
    "productName": "Project Command Center",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
